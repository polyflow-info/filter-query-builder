{
  "name": "@polyflow-info/filter-query-builder",
  "version": "0.0.1",
  "description": "Typed builders for Polyflow View API filter queries",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyflow-info/filter-query-builder.git"
  },
  "homepage": "https://github.com/polyflow-info/filter-query-builder#readme",
  "bugs": {
    "url": "https://github.com/polyflow-info/filter-query-builder/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:types": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}